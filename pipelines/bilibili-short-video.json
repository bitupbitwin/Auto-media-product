{
  "id": "bilibili-short-video",
  "platform": "bilibili",
  "mode": "short-video",
  "name": "哔哩哔哩 · 短视频",
  "steps": [
    {
      "id": "title",
      "name": "标题生成",
      "type": "title",
      "needs": [],
      "promptTemplate": "bilibili/short-video/title.md",
      "humanGate": true,
      "defaultProvider": "cli-claude"
    },
    {
      "id": "content",
      "name": "口播稿与简介生成",
      "type": "content",
      "needs": [
        "title"
      ],
      "promptTemplate": "bilibili/short-video/content.md",
      "defaultProvider": "cli-claude"
    },
    {
      "id": "cover",
      "name": "封面生成",
      "type": "cover",
      "needs": [
        "title"
      ],
      "promptTemplate": "bilibili/short-video/cover.md",
      "defaultProvider": "api-jimeng",
      "coverSizes": [
        {
          "w": 1080,
          "h": 1920,
          "label": "竖屏 9:16"
        }
      ],
      "coverSizesByAspect": {
        "9:16": [
          {
            "w": 1080,
            "h": 1920,
            "label": "竖屏 9:16"
          }
        ],
        "3:4": [
          {
            "w": 1080,
            "h": 1440,
            "label": "竖版 3:4"
          }
        ],
        "16:9": [
          {
            "w": 1920,
            "h": 1080,
            "label": "横版 16:9"
          }
        ]
      }
    },
    {
      "id": "video",
      "name": "分镜与剪映草稿",
      "type": "video",
      "needs": [
        "content"
      ],
      "promptTemplate": "bilibili/short-video/storyboard.md",
      "defaultProvider": "cli-gemini",
      "post": "jianying-draft"
    },
    {
      "id": "review",
      "name": "评审评分",
      "type": "review",
      "needs": [
        "title",
        "content"
      ],
      "promptTemplate": "common/review.md",
      "defaultProvider": "api-deepseek"
    }
  ],
  "notes": [
    "竖屏短视频建议 ≤60 秒，前 3 秒抛出钩子",
    "标题不超过 80 字，可用【】框出关键词，避免标题党",
    "切勿带其他平台水印（抖音/快手水印会被限流）",
    "标签最多 10 个，选 B 站站内热门精准标签",
    "简介区可引导一键三连，但不要过度乞求",
    "发布时间建议：12:00-13:00 / 18:00-23:00"
  ],
  "options": [
    {
      "id": "aspect",
      "label": "封面比例",
      "default": "9:16",
      "choices": [
        {
          "value": "9:16",
          "label": "竖屏 9:16"
        },
        {
          "value": "3:4",
          "label": "竖版 3:4"
        },
        {
          "value": "16:9",
          "label": "横版 16:9"
        }
      ]
    }
  ]
}
