{
  "id": "mv-song",
  "platform": "mv",
  "mode": "song",
  "name": "MV · 歌词可视化",
  "options": [
    {
      "id": "visualMode",
      "label": "生成形式",
      "default": "images",
      "choices": [
        { "value": "images", "label": "纯图片（图片轮播）" },
        { "value": "video", "label": "纯视频（分镜视频）" }
      ]
    },
    {
      "id": "aspect",
      "label": "画面比例",
      "default": "9:16",
      "choices": [
        { "value": "9:16", "label": "9:16 竖版" },
        { "value": "16:9", "label": "16:9 横版" }
      ]
    }
  ],
  "steps": [
    { "id": "lyrics", "name": "歌词与歌名生成", "type": "lyrics", "needs": [], "promptTemplate": "mv/lyrics.md", "defaultProvider": "cli-claude" },
    { "id": "image-prompts", "name": "图片提示词（全曲分段）", "type": "image-prompts", "needs": ["lyrics"], "promptTemplate": "mv/image-prompts.md", "defaultProvider": "cli-claude", "when": { "visualMode": "images" } },
    { "id": "video-prompts", "name": "视频提示词（全曲分镜）", "type": "video-prompts", "needs": ["lyrics"], "promptTemplate": "mv/video-prompts.md", "defaultProvider": "cli-claude", "when": { "visualMode": "video" } },
    { "id": "subtitle", "name": "SRT 字幕生成", "type": "subtitle", "needs": ["lyrics"], "promptTemplate": "mv/subtitle.md", "defaultProvider": "cli-claude" },
    {
      "id": "cover",
      "name": "封面图生成",
      "type": "cover",
      "needs": ["lyrics"],
      "promptTemplate": "mv/cover.md",
      "defaultProvider": "api-jimeng",
      "coverSizes": [{ "w": 1080, "h": 1920, "label": "竖屏封面 9:16" }],
      "coverSizesByAspect": {
        "9:16": [{ "w": 1080, "h": 1920, "label": "竖屏封面 9:16" }],
        "16:9": [{ "w": 1920, "h": 1080, "label": "横屏封面 16:9" }]
      }
    },
    { "id": "docx", "name": "提示词文档打包（docx）", "type": "docx", "needs": ["image-prompts", "video-prompts", "cover"] }
  ],
  "notes": [
    "创建流程时先选「生成形式」（纯图片/纯视频）与「画面比例」（9:16/16:9）",
    "纯图片：生成全曲分段图片提示词；纯视频：生成全曲分镜视频提示词（二选一，不混合）",
    "提示词按所选比例自动加入构图保护规范（竖版[VERTICAL 9:16] / 横版[HORIZONTAL 16:9]）",
    "封面尺寸随所选比例自动切换（9:16→1080x1920 / 16:9→1920x1080）",
    "封面默认用即梦（中文标题渲染好）；标题文字取歌名《》",
    "SRT 字幕时间轴按典型节奏估算，导入剪映/Pr 后需对齐到实际歌曲音频",
    "生成完整 MV：歌曲音频用 Suno 等生成，把图片/视频+字幕+音频在剪映中合成导出",
    "导出产物包内含 docx 提示词文档与 srt 字幕文档及封面图"
  ]
}
