{
  "id": "bilibili-images",
  "platform": "bilibili",
  "mode": "images",
  "name": "哔哩哔哩 · 图文",
  "steps": [
    {
      "id": "title",
      "name": "标题生成",
      "type": "title",
      "needs": [],
      "promptTemplate": "bilibili/images/title.md",
      "humanGate": true,
      "defaultProvider": "cli-claude"
    },
    {
      "id": "content",
      "name": "图文内容生成",
      "type": "content",
      "needs": [
        "title"
      ],
      "promptTemplate": "bilibili/images/content.md",
      "defaultProvider": "cli-claude"
    },
    {
      "use": "cover",
      "name": "首图生成",
      "promptTemplate": "bilibili/images/cover.md",
      "aspects": [
        "1:1",
        "3:4",
        "9:16",
        "16:9"
      ]
    },
    "image-prompts",
    {
      "use": "batch-images",
      "aspects": [
        "1:1",
        "3:4",
        "9:16",
        "16:9"
      ]
    },
    "review"
  ],
  "notes": [
    "图文动态配图最多 9 张，首图决定点击，信息最强的放第一张",
    "正文口语化、有梗但不堆梗，B 站用户反感营销腔",
    "话题（#话题#）选 1-3 个精准的，蹭不相关热门话题会被限流",
    "图片统一风格，文字大小保证手机端可读",
    "不要出现站外水印、二维码、引流信息"
  ],
  "options": [
    {
      "id": "aspect",
      "default": "1:1",
      "aspects": [
        "1:1",
        "3:4",
        "9:16",
        "16:9"
      ]
    },
    "imageGen"
  ]
}
