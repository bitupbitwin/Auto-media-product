{
  "id": "bilibili-images",
  "platform": "bilibili",
  "mode": "images",
  "name": "哔哩哔哩 · 图文",
  "steps": [
    {
      "id": "title",
      "name": "标题生成",
      "type": "title",
      "needs": [],
      "promptTemplate": "bilibili/images/title.md",
      "humanGate": true,
      "defaultProvider": "cli-claude"
    },
    {
      "id": "content",
      "name": "图文内容生成",
      "type": "content",
      "needs": [
        "title"
      ],
      "promptTemplate": "bilibili/images/content.md",
      "defaultProvider": "cli-claude"
    },
    {
      "id": "cover",
      "name": "首图生成",
      "type": "cover",
      "needs": [
        "title"
      ],
      "promptTemplate": "bilibili/images/cover.md",
      "defaultProvider": "api-jimeng",
      "coverSizes": [
        {
          "w": 1080,
          "h": 1080,
          "label": "方形 1:1"
        }
      ],
      "coverSizesByAspect": {
        "1:1": [
          {
            "w": 1080,
            "h": 1080,
            "label": "方形 1:1"
          }
        ],
        "3:4": [
          {
            "w": 1080,
            "h": 1440,
            "label": "竖版 3:4"
          }
        ],
        "9:16": [
          {
            "w": 1080,
            "h": 1920,
            "label": "竖屏 9:16"
          }
        ],
        "16:9": [
          {
            "w": 1920,
            "h": 1080,
            "label": "横版 16:9"
          }
        ]
      }
    },
    {
      "id": "image-prompts",
      "name": "内容配图提示词（多张）",
      "type": "image-prompts",
      "needs": [
        "content"
      ],
      "promptTemplate": "common/content-image-prompts.md",
      "defaultProvider": "cli-claude"
    },
    {
      "id": "batch-images",
      "name": "批量出图（按内容逐张生成）",
      "type": "batch-images",
      "needs": [
        "image-prompts"
      ],
      "promptTemplate": "",
      "defaultProvider": "api-mv-images",
      "when": {
        "imageGen": "real"
      },
      "coverSizes": [
        {
          "w": 1080,
          "h": 1080,
          "label": "方形 1:1"
        }
      ],
      "coverSizesByAspect": {
        "1:1": [
          {
            "w": 1080,
            "h": 1080,
            "label": "方形 1:1"
          }
        ],
        "3:4": [
          {
            "w": 1080,
            "h": 1440,
            "label": "竖版 3:4"
          }
        ],
        "9:16": [
          {
            "w": 1080,
            "h": 1920,
            "label": "竖屏 9:16"
          }
        ],
        "16:9": [
          {
            "w": 1920,
            "h": 1080,
            "label": "横版 16:9"
          }
        ]
      }
    },
    {
      "id": "review",
      "name": "评审评分",
      "type": "review",
      "needs": [
        "title",
        "content"
      ],
      "promptTemplate": "common/review.md",
      "defaultProvider": "api-deepseek"
    }
  ],
  "notes": [
    "图文动态配图最多 9 张，首图决定点击，信息最强的放第一张",
    "正文口语化、有梗但不堆梗，B 站用户反感营销腔",
    "话题（#话题#）选 1-3 个精准的，蹭不相关热门话题会被限流",
    "图片统一风格，文字大小保证手机端可读",
    "不要出现站外水印、二维码、引流信息"
  ],
  "options": [
    {
      "id": "aspect",
      "label": "封面比例",
      "default": "1:1",
      "choices": [
        {
          "value": "1:1",
          "label": "方形 1:1"
        },
        {
          "value": "3:4",
          "label": "竖版 3:4"
        },
        {
          "value": "9:16",
          "label": "竖屏 9:16"
        },
        {
          "value": "16:9",
          "label": "横版 16:9"
        }
      ]
    },
    {
      "id": "imageGen",
      "label": "内容配图",
      "default": "prompts",
      "choices": [
        {
          "value": "prompts",
          "label": "仅出图提示词"
        },
        {
          "value": "real",
          "label": "真实出图（按内容批量生成多张图）"
        }
      ]
    }
  ]
}
