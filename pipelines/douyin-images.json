{
  "id": "douyin-images",
  "platform": "douyin",
  "mode": "images",
  "name": "抖音 · 图集",
  "options": [
    {
      "id": "aspect",
      "default": "3:4",
      "aspects": [
        "3:4",
        "9:16",
        "1:1",
        "16:9"
      ],
      "label": "画面比例"
    },
    "imageGen"
  ],
  "steps": [
    {
      "id": "title",
      "name": "标题生成",
      "type": "title",
      "needs": [],
      "promptTemplate": "douyin/images/title.md",
      "humanGate": true,
      "defaultProvider": "cli-claude"
    },
    {
      "id": "content",
      "name": "图集文案与简介",
      "type": "content",
      "needs": [
        "title"
      ],
      "promptTemplate": "douyin/images/content.md",
      "defaultProvider": "cli-claude"
    },
    {
      "use": "cover",
      "name": "首图/封面生成",
      "promptTemplate": "douyin/images/cover.md",
      "aspects": [
        "3:4",
        "9:16",
        "1:1",
        "16:9"
      ]
    },
    {
      "use": "image-prompts",
      "promptTemplate": "douyin/images/image-prompts.md"
    },
    {
      "use": "batch-images",
      "aspects": [
        "3:4",
        "9:16",
        "1:1",
        "16:9"
      ]
    },
    "review"
  ],
  "notes": [
    "创建时先选「画面比例」与「内容配图」（仅提示词/真实出图）",
    "「真实出图」会按内容把图集的每张配图逐张生成（每张概括一个要点），可单张重抽/替换",
    "图集 3-12 张，首图决定点击率，必须放最强信息点",
    "封面/配图比例随所选自动设定（出图时直接按比例生成，不裁剪）",
    "图片统一风格（配色/字体/版式），文字大且居中，保证手机端可读",
    "避免图片中出现水印、二维码、其他平台 logo"
  ]
}
